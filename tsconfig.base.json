{
  // Shared compiler options for every tsconfig in this repository.
  // Strictness policy: `strict: true` PLUS every additional strictness flag
  // spelled out explicitly, so that a future TypeScript release changing a
  // default cannot silently weaken this repository.
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "bundler",
    // No DOM, no WebWorker, no Node globals — yes, in an audio repository.
    //
    // Keeping `DOM` out is what forces the WebAudio-specific parts behind
    // `AudioBackendPort`, and what lets the whole thing be tested in Node with
    // no jsdom and no AudioContext.
    //
    // THE WEBAUDIO ADAPTER SHIPPED WITHOUT CHANGING THIS LINE, and that was the
    // point. `domain/webaudio-adapter.ts` talks to a real `AudioContext`
    // through `domain/webaudio-surface.ts`, which describes structurally the
    // handful of members it uses; `test/webaudio-surface.test.ts` compiles a
    // fixture against the real `lib.dom.d.ts` to prove a real `AudioContext`
    // satisfies those types with no cast. mc-save's `indexeddb-surface.ts`,
    // mc-render's `dom-surface.ts` and mx-ui do the same.
    //
    // DO NOT ADD "DOM" HERE. With it on, every module in `domain/` silently
    // becomes able to reach `window`, `document` and `localStorage`; the suite
    // stays green, `pnpm typecheck` stops being a proof that this toolkit is
    // platform-free, and nobody notices for months. If something genuinely
    // cannot be described structurally, say so in
    // `domain/webaudio-surface.ts` — it already names the one member that
    // could not (`AudioNode.connect`) and what that costs.
    "lib": ["ES2024"],
    "types": [],

    "allowJs": false,
    "checkJs": false,

    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "removeComments": false,

    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "useUnknownInCatchVariables": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "resolvePackageJsonExports": true,
    "resolvePackageJsonImports": true,
    "skipLibCheck": true,

    "newLine": "lf",
    "stripInternal": true,

    // No build step yet (see README 現状). Every tsconfig here is check-only;
    // `package.json#exports` points at TypeScript source. The emitting
    // build/publish pipeline is added when this repo reaches completion.
    "noEmit": true,

  }
}
