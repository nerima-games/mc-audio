{
  // Shared compiler options for every tsconfig in this repository.
  // Strictness policy: `strict: true` PLUS every additional strictness flag
  // spelled out explicitly, so that a future TypeScript release changing a
  // default cannot silently weaken this repository.
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "bundler",
    // No DOM, no WebWorker, no Node globals — yes, in an audio repository.
    //
    // Everything mc-audio currently ships is pure: the cue registry, the volume
    // arithmetic, the BGM state machine and the caption stream. Keeping `DOM`
    // out is what forces the WebAudio-specific parts behind `AudioBackendPort`,
    // and what lets the whole thing be tested in Node with no jsdom and no
    // AudioContext. The WebAudio adapter that adds "DOM" is deliberately the
    // last thing written, not the first (see docs/public-api.md).
    "lib": ["ES2024"],
    "types": [],

    "allowJs": false,
    "checkJs": false,

    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "removeComments": false,

    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "useUnknownInCatchVariables": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "resolvePackageJsonExports": true,
    "resolvePackageJsonImports": true,
    "skipLibCheck": true,

    "newLine": "lf",
    "stripInternal": true,

    // No build step yet (see README 現状). Every tsconfig here is check-only;
    // `package.json#exports` points at TypeScript source. The emitting
    // build/publish pipeline is added when this repo reaches completion.
    "noEmit": true,

    "baseUrl": "."
  }
}
