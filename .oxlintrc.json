{
  "$schema": "https://oxc-project.github.io/oxc/schema/linter.json",
  // oxlint is the ONLY lint/format configuration in this repository.
  // There is deliberately no prettier, no biome and no .editorconfig.
  //
  // NOTE on the `Date.now()` ban: oxlint does not implement
  // `no-restricted-syntax` or `no-restricted-properties`, and while
  // `no-restricted-globals` is listed by `oxlint --rules` it is not
  // implemented either (no checkmark). A file containing `Date.now()`
  // produces no diagnostics under those rules. The ban is therefore enforced
  // structurally by `.ast-grep/rules/no-wall-clock-read.yml` (`pnpm lint`
  // also runs `ast-grep scan`) instead of by oxlint.
  "env": {
    "es2022": true,
    "node": true
  },
  "settings": {
    "typescript": {
      "version": "7.0"
    }
  },
  "plugins": [],
  "categories": {
    "correctness": "warn",
    "suspicious": "warn",
    "perf": "warn",
    "style": "warn",
    "restriction": "warn"
  },
  "rules": {
    // TypeScript-specific rules
    // Prefer `type` over `interface` for pure data types (Schema.Struct pattern).
    "@typescript-eslint/consistent-type-definitions": ["warn", "type"],
    "@typescript-eslint/no-explicit-any": "off",
    "@typescript-eslint/no-unused-vars": "warn",
    "@typescript-eslint/no-floating-promises": "warn",
    "@typescript-eslint/no-misused-new": "warn",
    "@typescript-eslint/no-unnecessary-type-assertion": "warn",
    "@typescript-eslint/no-var-requires": "warn",
    "@typescript-eslint/prefer-enum-initializers": "warn",
    "@typescript-eslint/prefer-for-of": "warn",
    "@typescript-eslint/prefer-literal-enum-member": "warn",

    // Correctness
    "no-array-constructor": "warn",
    "no-empty": "warn",
    "no-eq-null": "warn",
    "no-extra-boolean-cast": "warn",
    "no-fallthrough": "warn",
    "no-irregular-whitespace": "warn",
    "no-self-compare": "warn",
    "no-throw-literal": "warn",
    "no-unreachable": "warn",
    "use-isnan": "warn",
    "valid-typeof": "warn",

    // Suspicious
    "no-console": "warn",
    "no-debugger": "warn",
    "no-empty-function": "warn",
    "no-empty-pattern": "warn",
    "no-eval": "error",
    "no-implied-eval": "error",
    "no-redeclare": "warn",
    "no-shadow": "warn",
    "no-unreachable-loop": "warn",
    "no-unused-private-class-members": "warn",

    // Performance
    "no-await-in-loop": "warn",
    "no-loop-func": "warn",
    "no-promise-executor-return": "warn",
    "no-sync": "warn",

    // Style
    // NOTE (2026-08-01, discovered while fixing the oxlint.json -> .oxlintrc.json
    // filename bug that made this whole file silently ignored): the formatting
    // rules that used to live here (array-bracket-spacing, block-spacing,
    // brace-style, camelcase, comma-dangle, comma-spacing, comma-style,
    // computed-property-spacing, eol-last, func-call-spacing, indent, key-spacing,
    // keyword-spacing, linebreak-style, lines-between-class-members,
    // no-mixed-spaces-and-tabs, no-new-object, no-tabs, no-trailing-spaces,
    // no-whitespace-before-property, object-curly-spacing,
    // operator-linebreak, padded-blocks, quote-props, semi-spacing,
    // space-before-blocks, space-infix-ops, space-unary-ops, spaced-comment)
    // do not exist in the current Oxlint rule set ("Rule '<name>' not found in plugin 'eslint'"),
    // which makes oxlint fail to parse the config entirely (exit 1, no linting
    // performed at all). They were apparently written against an older/aspirational
    // rule set (this file's own header comment once referenced oxlint 0.12) and were
    // never actually validated because the file was never loaded until now. They
    // have been removed so the config parses; the `"style": "warn"` category
    // default above still enables whatever style-category rules actually exist in
    // this oxlint version. Restoring equivalent formatting enforcement (if wanted)
    // would need a real formatter or the @stylistic rule set, tracked separately.
    "no-array-method-this-argument": "warn",
    "no-bitwise": "warn",
    // NOTE (Wave 0): `one-var` is not a recognized rule in oxlint 1.75.0 (the
    // org-pinned Nix version, per flake.nix's nixpkgs comment) — it errors
    // "Rule 'one-var' not found in plugin 'eslint'" rather than silently
    // ignoring it, so the entry that used to disable it here was removed
    // rather than left dead. The repository's "one binding per statement"
    // policy has no mechanical rule to carry it at this oxlint version.
    // `x`/`y`/`z` are the universal 3D-vector field names (`Vec3` in
    // src/domain/volume.ts and every spatial-audio call site that constructs
    // one). Vec3 is internal (not re-exported from src/index.ts) so renaming
    // is not an API-compat concern, but it would still touch every
    // construction site across src/ and apps/ for a rule whose whole purpose
    // is discouraging *unclear* short names — x/y/z are the opposite of
    // unclear in a coordinate type. Exempting them via the rule's own
    // `exceptions` option rather than disabling `id-length` entirely.
    "id-length": ["warn", { "exceptions": ["x", "y", "z"] }],

    // Restriction
    "default-case": "warn",
    "default-case-last": "warn",
    "no-empty-character-class": "warn",
    // Declared for intent and for the day Oxlint implements it.
    // The wall-clock-read policy this hints at is enforced structurally by
    // `.ast-grep/rules/no-wall-clock-read.yml` instead (see the NOTE above).
    "no-restricted-globals": ["warn", "name", "open", "close", "event"],
    // DEPENDENCY_POLICY.md §5, Tier1 example: mc-audio has zero declared
    // internal dependencies (docs/architecture.md §3), so every
    // @nerima-games/* import is banned except mc-kernel, which is
    // universally importable and exempt from all allow-lists.
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "effect",
            "message": "Please use named imports from 'effect' package",
            "importNames": ["default"]
          }
        ],
        // NOTE (2026-08-01): `patterns[].regex` is silently a no-op in oxlint 1.76.0 -
        // verified empirically (see also the oxlint.json -> .oxlintrc.json filename
        // fix in this same commit): a minimal repro config using
        // `{"patterns": [{"regex": "..."}]}` produces zero diagnostics and exit 0
        // against a file that should violate it, while the equivalent
        // `{"patterns": [{"group": [...]}]}` glob form fires correctly. Using
        // `group` (gitignore-style globs, with `!`-prefixed entries to exempt
        // mc-kernel and its subpaths) instead of `regex` below.
        "patterns": [
          {
            "group": ["@nerima-games/**", "!@nerima-games/mc-kernel", "!@nerima-games/mc-kernel/**"],
            "message": "mc-audio is Tier1 (DEPENDENCY_POLICY.md §1); only the listed packages may be imported."
          }
        ]
      }
    ],
    "prefer-template": "warn",

    // Disabled rules (conflict with project style)
    "@typescript-eslint/explicit-function-return-type": "off",
    "@typescript-eslint/explicit-module-boundary-types": "off",
    "@typescript-eslint/no-non-null-assertion": "off",
    "no-case-declarations": "off",
    "no-constant-condition": "off",
    "no-param-reassign": "off",
    "no-plusplus": "off"
  },
  // Strictness policy: `src/**` (production audio domain code) stays fully
  // strict under the `style`/`restriction` category defaults above — every
  // rule that fires there is meant to be fixed in code, never disabled here.
  // `test/**`, `apps/**` (the preview-soundboard dev tool) and `scripts/**`
  // are dev-tooling/spec code, not shipped product: numeric literals in
  // assertions (durations, gains, frequencies), short loop/index identifiers,
  // ternaries in ad-hoc CLI rendering, and unsorted object keys in fixtures
  // are accepted there by design and were never actually fixed, only
  // silently unenforced before oxlint was correctly wired up (see the
  // 2026-08-01 NOTE above on this file being ignored under its old name).
  // `no-shadow` is deliberately excluded from this override — it is an
  // explicit correctness rule in the "Suspicious" section above, not a
  // style-category default, so shadowing bugs in tests get fixed in code too.
  "overrides": [
    {
      "files": ["test/**", "apps/**", "scripts/**"],
      "rules": {
        "no-magic-numbers": "off",
        "id-length": "off",
        "no-ternary": "off",
        "no-nested-ternary": "off",
        "sort-keys": "off",
        "sort-imports": "off",
        "capitalized-comments": "off",
        "no-undefined": "off",
        "func-names": "off",
        "max-statements": "off",
        "prefer-destructuring": "off",
        "no-continue": "off",
        "max-params": "off",
        "new-cap": "off",
        "no-use-before-define": "off",
        "complexity": "off",
        "no-void": "off"
      }
    }
  ],
  "ignorePatterns": ["node_modules/**", "coverage/**", "dist/**", ".git/**", "*.config.ts", "docs/**"]
}
