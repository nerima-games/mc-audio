{
  // Tests and repo tooling. Node types are available here and only here.
  // Unlike the reference repository this project does NOT relax any strictness
  // flag for tests: test code is code, and a skeleton has no legacy to grandfather.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "scripts/**/*.ts", "vitest.config.ts"],
  // `test/fixtures/**` is excluded on purpose: it names `AudioContext`,
  // `OscillatorNode` and friends, which this project has no `lib.DOM` for. It is
  // compiled BY a test (`test/webaudio-surface.test.ts`) with DOM turned on, and
  // that compilation is the proof `domain/webaudio-surface.ts` rests on. It is
  // still linted and still scanned by `pnpm check:deps`.
  "exclude": ["node_modules", "coverage", "dist", "test/fixtures/**"]
}
