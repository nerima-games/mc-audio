{
  "name": "@nerima-games/mc-audio",
  "version": "0.2.7",
  "type": "module",
  "description": "Audio toolkit for a Minecraft-compatible game: sound events and resource manifests, volume categories, BGM state, captions, and a testable WebAudio backend.",
  "homepage": "https://github.com/nerima-games/mc-audio#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nerima-games/mc-audio.git"
  },
  "bugs": {
    "url": "https://github.com/nerima-games/mc-audio/issues"
  },
  "author": "takeokunn",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.24.0"
  },
  "packageManager": "pnpm@11.24.0",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "keywords": [
    "minecraft",
    "effect-ts",
    "typescript",
    "webaudio",
    "captions",
    "accessibility",
    "audio"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.build.json --pretty false && tsc -p tsconfig.test.json --pretty false && tsc -p tsconfig.preview.json --pretty false",
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.release.json --pretty false",
    "lint": "oxlint --deny-warnings src test apps scripts && ast-grep scan",
    "lint:fix": "oxlint --fix src test apps scripts",
    "import:minecraft-sounds": "tsx scripts/import-minecraft-sounds.ts",
    "import:minecraft-26-3-snapshot-9": "pnpm import:minecraft-sounds -- 26.3-snapshot-9",
    "preview": "tsx apps/preview-soundboard/main.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify": "pnpm typecheck && pnpm lint && pnpm test",
    "package:verify": "pnpm build && node scripts/verify-package.mjs",
    "prepublishOnly": "pnpm verify && pnpm package:verify"
  },
  "dependencies": {
    "@nerima-games/mc-kernel": "0.7.0",
    "effect": "3.22.1"
  },
  "devDependencies": {
    "@changesets/changelog-github": "1.0.0",
    "@changesets/cli": "3.0.1",
    "@effect/vitest": "0.30.0",
    "@types/node": "26.4.0",
    "@vitest/coverage-v8": "4.1.11",
    "knip": "6.33.0",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
