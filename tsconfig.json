{
  // Editor / language-server default project: everything in the repository.
  // CI gates use tsconfig.build.json (shipped source) and tsconfig.test.json
  // (tests + tooling); this file exists so that opening any file in an editor
  // resolves against the same options.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "scripts/**/*.ts", "apps/**/*.ts", "vitest.config.ts"],
  // `test/fixtures/**` is excluded because it deliberately names DOM types this
  // project cannot see. It is compiled by `test/webaudio-surface.test.ts`
  // against the real `lib.dom.d.ts`; see `domain/webaudio-surface.ts`.
  "exclude": ["node_modules", "coverage", "dist", "test/fixtures/**"]
}
